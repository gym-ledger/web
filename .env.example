# Public URL of the API (gym-ledger/api) — no trailing slash
# This is baked into the build, so it must be set before running docker compose up --build
NEXT_PUBLIC_API_URL=http://your-server-ip:4000/api/v1

# Shown in the privacy policy (/privacy) as who runs this instance and where
# users send data requests. Baked into the build like NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=
