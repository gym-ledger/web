<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets the emulator reach the local API over plain HTTP
     (see res/xml/network_security_config.xml). Release builds use the main
     manifest, which has no network security config, so they stay HTTPS-only. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
